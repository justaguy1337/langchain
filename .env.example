# ==============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# LangSmith / LangChain Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langchain_api_key_here
LANGCHAIN_PROJECT=your_project_name

# LLM & Embedding API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here

# DataStax Astra DB (Vector Database)
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_application_token_here
ASTRA_DB_ID=your_astra_db_id_here
ASTRA_DB_API_ENDPOINT=https://your-db-id-region.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=default_keyspace
